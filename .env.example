# Resend
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM=noreply@your-verified-domain.com
# Display name is set in code to "Daily Emails <EMAIL_FROM>"
EMAIL_TO=streethouse4@gmail.com
# Optional overrides for usage-watch quotas (free-plan defaults)
# RESEND_DAILY_LIMIT=100
# RESEND_MONTHLY_LIMIT=3000

# Optional SMTP fields (unused — Resend API is enough)
# EMAIL_SERVER_HOST=smtp.resend.com
# EMAIL_SERVER_PORT=465
# EMAIL_SERVER_USER=resend
# EMAIL_SERVER_PASSWORD=re_xxxxxxxx

# Vercel Cron auth (also set in Vercel project env)
CRON_SECRET=generate-a-long-random-string

# Hosted markets page (secret URL: /markets/<MARKETS_PAGE_SECRET>)
# Generate a long random string, e.g. openssl rand -hex 24
MARKETS_PAGE_SECRET=generate-a-long-random-string
# Public site origin for the email CTA (optional on Vercel — falls back to
# VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL; local default http://localhost:3000)
# APP_BASE_URL=https://your-app.vercel.app

# Vercel AI Gateway (local only; on Vercel OIDC can work without this)
AI_GATEWAY_API_KEY=
AI_MODEL=google/gemini-2.5-flash
# Free monthly credit budget used for usage-watch % (default $5)
# AI_GATEWAY_MONTHLY_BUDGET=5

# Vercel Blob — day-over-day snapshot history (optional locally;
# without it, snapshots save to .data/previous-brief.json)
# Create a Blob store in the Vercel dashboard and paste the token:
BLOB_READ_WRITE_TOKEN=
# BLOB_STORE_ID=

# Platform usage (Fast Origin Transfer, invocations, Blob ops) via /v2/usage.
# Create a token at https://vercel.com/account/tokens — required for live reads on Vercel.
# Without it, production falls back to the last successful sync cached in Blob
# (refreshed automatically whenever a local/dev run can auth via the Vercel CLI).
# VERCEL_TOKEN=
# Defaults to orgId from .vercel/project.json when linked; on Vercel, VERCEL_ORG_ID is set automatically:
# VERCEL_TEAM_ID=

# Google Analytics 4 — Sites overview in the daily email (optional).
# Create a GCP service account, enable Analytics Data + Admin APIs, download a JSON key,
# then add the service account email as Viewer on each GA account.
# GOOGLE_CLIENT_EMAIL=daily-emails@your-project.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
