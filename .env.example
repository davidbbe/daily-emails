# Resend
# Both daily emails use the same sender and recipient; no extra configuration.
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM=noreply@your-verified-domain.com
# Display name is set in code to "Daily Emails <EMAIL_FROM>"
EMAIL_TO=streethouse4@gmail.com
# GET /usage requires a full-access API key. Keep sending-only RESEND_API_KEY
# for delivery and set a separate full-access key for reporting (same account).
# If omitted, usage tries RESEND_API_KEY, which must then have full access.
# RESEND_USAGE_API_KEY=re_xxxxxxxx
# No RESEND_DAILY_LIMIT / RESEND_MONTHLY_LIMIT overrides are needed.

# Optional SMTP fields (unused — Resend API is enough)
# EMAIL_SERVER_HOST=smtp.resend.com
# EMAIL_SERVER_PORT=465
# EMAIL_SERVER_USER=resend
# EMAIL_SERVER_PASSWORD=re_xxxxxxxx

# Vercel Cron auth (also set in Vercel project env)
# One run at 09:00 UTC sends the main brief and Analytics, Billing & Usage email.
CRON_SECRET=generate-a-long-random-string

# Hosted markets page (secret URL: /markets/<MARKETS_PAGE_SECRET>)
# Generate a long random string, e.g. openssl rand -hex 24
MARKETS_PAGE_SECRET=generate-a-long-random-string
# Public site origin for the email CTA (optional on Vercel — falls back to
# VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL; local default http://localhost:3000)
# APP_BASE_URL=https://your-app.vercel.app

# Vercel AI Gateway (local only; on Vercel OIDC can work without this)
AI_GATEWAY_API_KEY=
# GPT-5 mini uses explicit low reasoning; all generation deadlines remain 60s.
AI_MODEL=openai/gpt-5-mini
# Configured monthly spend budget for usage-watch % (default $5), not a free-credit allowance or provider cap.
# AI_GATEWAY_MONTHLY_BUDGET=5

# Vercel Blob — snapshots, markets page, and usage caches (optional locally).
# Without it, local runs save under .data/; Vercel cannot persist locally.
# Create a Blob store in the Vercel dashboard and paste the token:
BLOB_READ_WRITE_TOKEN=
# Must match the store's access mode. Default public preserves existing stores.
# Use a private store + BLOB_ACCESS=private to protect saved JSON directly.
# Changing this value does not convert or remove an existing public store.
# BLOB_ACCESS=private
# BLOB_STORE_ID=

# Platform usage (CDN transfer/requests, invocations, Blob storage/transfer/ops).
# Dashboard meters over the rolling 30 days ending now, including today; no monthly reset.
# Hobby allowances require a confirmed team plan; other caps remain unverified.
# Blob storage is the provider's rolling team average in this range;
# Blob transfer/operations are totals. Connected-store size is a separate snapshot.
# Create a token at https://vercel.com/account/tokens — required for live reads on Vercel.
# Without it, production can use a same-team Blob snapshot younger than 24 hours
# (refreshed automatically whenever a local/dev run can auth via the Vercel CLI).
# VERCEL_TOKEN=
# Defaults to orgId from .vercel/project.json when linked; on Vercel, VERCEL_ORG_ID is set automatically:
# VERCEL_TEAM_ID=

# Google Analytics 4 + Cloud Billing — optional.
# These reports and all usage data appear only in the operations email.
# Create a GCP service account, enable Analytics Data + Admin APIs, download a JSON key,
# then add the service account email as Viewer on each GA account.
# Sites and exact GA4 property IDs are configured in src/lib/config.ts.
# Restaurant Roulette needs Viewer access on property 477168801 (account 344920077).
# GOOGLE_CLIENT_EMAIL=daily-emails@your-project.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Cloud Billing month-to-date chart (AI Greeting Card + Restaurant Roulette, 016802-8E2106-038F4F).
# Export must live on a project billed to that account (not daily-emails-504418
# if that project is on a different billing account). See README.
# GCP_BILLING_ACCOUNT_ID=016802-8E2106-038F4F
# GCP_BILLING_BQ_TABLE=gen-lang-client-0444583310.billing_export.gcp_billing_export_v1_016802_8E2106_038F4F
# GCP_BILLING_BQ_JOB_PROJECT=YOUR_QUERY_PROJECT
# GOOGLE_CLOUD_PROJECT=daily-emails-504418
