# Resend
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM=noreply@your-verified-domain.com
# Display name is set in code to "Agent Dave <EMAIL_FROM>"
EMAIL_TO=streethouse4@gmail.com

# Optional SMTP fields (unused — Resend API is enough)
# EMAIL_SERVER_HOST=smtp.resend.com
# EMAIL_SERVER_PORT=465
# EMAIL_SERVER_USER=resend
# EMAIL_SERVER_PASSWORD=re_xxxxxxxx

# Vercel Cron auth (also set in Vercel project env)
CRON_SECRET=generate-a-long-random-string

# Vercel AI Gateway (local only; on Vercel OIDC can work without this)
AI_GATEWAY_API_KEY=
AI_MODEL=google/gemini-2.5-flash

# Vercel Blob — day-over-day trend movers + watchlist delta (optional locally;
# without it, snapshots save to .data/previous-brief.json)
# Create a Blob store in the Vercel dashboard and paste the token:
BLOB_READ_WRITE_TOKEN=
